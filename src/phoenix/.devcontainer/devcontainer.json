// For format details, see https://containers.dev/implementors/json_reference/
{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.schema.json",
  "name": "Phoenix",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "runServices": [
    "app",
    "${templateOption:database}"
  ],
  // Forward Phoenix port; PostgreSQL port is only relevant when using postgresql
  "forwardPorts": [
    4000,
    5432
  ],
  "portsAttributes": {
    "4000": {
      "label": "Phoenix",
      "onAutoForward": "notify"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  // Node.js — used by Phoenix for asset compilation (esbuild/tailwindcss)
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "containerEnv": {
    "MIX_ENV": "dev",
    "PHOENIX_DATABASE": "${templateOption:database}"
  },
  // Install project dependencies; use $PHOENIX_DATABASE with phx.new: mix phx.new myapp --database $PHOENIX_DATABASE
  "postCreateCommand": "mix archive.install hex phx_new --force && (mix deps.get || true)",
  "customizations": {
    "vscode": {
      "extensions": [
        // Elixir language support
        "JakeBecker.elixir-ls",
        // Elixir formatter and snippets
        "pantajoe.vscode-elixir-credo",
        // Phoenix / HEEx template support
        "phoenixframework.phoenix"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[elixir]": {
          "editor.defaultFormatter": "JakeBecker.elixir-ls"
        },
        "[phoenix-heex]": {
          "editor.defaultFormatter": "JakeBecker.elixir-ls"
        },
        "elixirLS.dialyzerEnabled": true
      }
    }
  },
  "remoteUser": "vscode"
}
